#ifndef CELLOX_CONFIGURATION_H_
#define CELLOX_CONFIGURATION_H_

// the configured options and settings for Cellox
#define PROJECT_VERSION_MAJOR (@Cellox_VERSION_MAJOR@)
#define PROJECT_VERSION_MINOR (@Cellox_VERSION_MINOR@)
#define PROJECT_VERSION_PATCH (@Cellox_VERSION_PATCH@)
#define PROJECT_NAME ("@PROJECT_NAME@")

// Absolute path to the standard library directory.
// At install time this points to <prefix>/lib/cellox/stdlib.
// During development / test builds it points to the source tree's stdlib/.
#define CELLOX_STDLIB_DIR ("@CELLOX_STDLIB_SOURCE_DIR@")

#endif