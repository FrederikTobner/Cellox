// Sliding-window sum — compute the sum of every contiguous sub-array of size k
// Demonstrates: slices, array_length(), nested loops

var nums = {3, 1, 4, 1, 5, 9, 2, 6, 5, 3};
var k = 3;
var n = array_length(nums);

printf("Array: {}\n", nums);
printf("Window size: {}\n", k);
printf("Window sums:\n");

// i + k must be strictly less than n so the upper bound (i+k) is valid for slicing
for (var i = 0; i + k < n; i += 1) {
    var window = nums[i .. i + k];
    var sum = 0;
    for (var j = 0; j < k; j += 1)
        sum += window[j];
    printf("  nums[{}..{}] = {} -> sum {}\n", i, i + k, window, sum);
}
