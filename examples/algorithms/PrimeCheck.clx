// Trial-division primality test
// Demonstrates: while loops, early return, for loops

fun isPrime(n) {
    if (n < 2) return false;
    if (n == 2) return true;
    if (n % 2 == 0) return false;
    var i = 3;
    while (i * i <= n) {
        if (n % i == 0) return false;
        i += 2;
    }
    return true;
}

// List all primes up to 60
printf("Primes up to 60:\n");
for (var i = 2; i <= 60; i += 1) {
    if (isPrime(i))
        printf("{} ", i);
}
printf("\n");

// Spot checks
printf("\nisPrime(97)  = {}\n", isPrime(97));   // true
printf("isPrime(100) = {}\n", isPrime(100));    // false
printf("isPrime(1)   = {}\n", isPrime(1));      // false
