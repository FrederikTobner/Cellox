// Collatz Conjecture — apply 3n+1 or n/2 until reaching 1 (https://en.wikipedia.org/wiki/Collatz_conjecture)
fun collatz(n) {
    var steps = 0;
    while (n != 1) {
        if (n % 2 == 0)
            n = n / 2;
        else
            n = 3 * n + 1;
        steps += 1;
    }
    return steps;
}

for (var i = 1; i <= 20; i += 1)
    printf("collatz({}) = {} steps\n", i, collatz(i));
