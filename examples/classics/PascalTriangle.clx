// Pascal's Triangle — each entry is the sum of the two above it (https://en.wikipedia.org/wiki/Pascal%27s_triangle)
var rows = 8;
var row = {1};

for (var r = 0; r < rows; r += 1) {
    printf("{}\n", row);
    // Build the next row: start with 1, add adjacent pairs, end with 1
    var next = {1};
    for (var i = 1; i < r + 1; i += 1)
        next = next + {row[i - 1] + row[i]};
    next = next + {1};
    row = next;
}
