// Palindrome checker: a string that reads the same forwards and backwards
// Demonstrates: string indexing, while loops, for loops

fun isPalindrome(s) {
    var lo = 0;
    var hi = strlen(s) - 1;
    while (lo < hi) {
        if (s[lo] != s[hi]) return false;
        lo += 1;
        hi -= 1;
    }
    return true;
}

var words = {"racecar", "hello", "level", "world", "madam", "noon", "cellox"};
var n = array_length(words);
for (var i = 0; i < n; i += 1)
    printf("{}: {}\n", words[i], isPalindrome(words[i]));
