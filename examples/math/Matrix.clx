// 2×2 matrix: addition, multiplication, transpose, and determinant
// Demonstrates: classes, arithmetic, method chaining on return values

class Matrix2x2 {
    // Stores:  [ a  b ]
    //          [ c  d ]
    init(a, b, c, d) {
        this.a = a; this.b = b;
        this.c = c; this.d = d;
    }

    add(other) {
        return Matrix2x2(
            this.a + other.a, this.b + other.b,
            this.c + other.c, this.d + other.d
        );
    }

    mul(other) {
        return Matrix2x2(
            this.a * other.a + this.b * other.c,
            this.a * other.b + this.b * other.d,
            this.c * other.a + this.d * other.c,
            this.c * other.b + this.d * other.d
        );
    }

    transpose() {
        return Matrix2x2(this.a, this.c, this.b, this.d);
    }

    det() { return this.a * this.d - this.b * this.c; }

    print() {
        printf("[ {} {} ]\n", this.a, this.b);
        printf("[ {} {} ]\n", this.c, this.d);
    }
}

var m1 = Matrix2x2(1, 2, 3, 4);
var m2 = Matrix2x2(5, 6, 7, 8);

printf("M1:\n");        m1.print();
printf("M2:\n");        m2.print();
printf("M1 + M2:\n");   m1.add(m2).print();
printf("M1 * M2:\n");   m1.mul(m2).print();
printf("det(M1) = {}\n", m1.det());       // 1*4 - 2*3 = -2
printf("transpose(M1):\n"); m1.transpose().print();
